{
  "name": "memovida",
  "version": "1.1.0",
  "description": "MemoVida · Asistente web para personas con Alzheimer y sus cuidadores. Frontend HTML/CSS/JS + backend Node.js sin dependencias.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test/smoke.mjs",
    "reset": "node -e \"import('node:fs').then(fs=>fs.rmSync('data/db.json',{force:true}))\"",
    "demo": "node tools/build-demo.mjs",
    "demo:serve": "node tools/serve-demo.mjs",
    "shots": "node tools/shots.mjs",
    "apk": "node tools/build-demo.mjs && node tools/build-apk.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "playwright": "^1.49.1"
  }
}
